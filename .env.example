# AI Order Return-Risk Scorer — Environment Configuration Template
# Copy this file to .env for custom local or production overrides.

# Server & Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database URL (SQLite default; can be overridden with PostgreSQL)
DATABASE_URL=sqlite:///backend/data/return_risk.db

# API Configuration
API_BASE_URL=http://127.0.0.1:8000/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","*"]

# Machine Learning Engine Configuration
MODEL_VERSION=order-return-risk-model-v1.0
MODEL_ARTIFACT_PATH=ml/models/best_model.joblib
MODEL_METADATA_PATH=ml/models/model_metadata.json

# Risk Threshold Defaults (Percentages 0-100)
LOW_RISK_THRESHOLD=39
MEDIUM_RISK_THRESHOLD=40
HIGH_RISK_THRESHOLD=70
AUTO_FLAG_THRESHOLD=80

# Currency & Locale (Strictly INR)
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
DEFAULT_LOCALE=en-IN
